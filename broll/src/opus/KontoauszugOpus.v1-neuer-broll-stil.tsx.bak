const SCENES: Scene[] = [
  { from: 0, to: 3.44, origin: "50% 55%", El: SceneKonto },
  { from: 3.44, to: 6.32, origin: "50% 50%", El: SceneBerater },
  { from: 6.32, to: 11.44, origin: "50% 45%", El: SceneBon },
  { from: 11.44, to: 14.8, origin: "50% 50%", El: SceneSteuer },
  { from: 14.8, to: 25.88, origin: "50% 62%", El: SceneChat },
  { from: 25.88, to: 31.84, origin: "50% 60%", El: SceneListe },
  { from: 31.84, to: 99, origin: "50% 55%", El: SceneGuide },
];

// ---------- captions: 2-3 words, mono caps pill on the seam ----------
type Cap = { text: string; startMs: number; endMs: number };
const chunks = (() => {
  const out: { text: string; start: number; end: number }[] = [];
  let cur: Cap[] = [];
  const flush = () => {
    if (!cur.length) return;
    out.push({ text: cur.map((c) => c.text.replace(/[.,!?]/g, "")).join(" ").toUpperCase(), start: cur[0].startMs / 1000, end: cur[cur.length - 1].endMs / 1000 });
    cur = [];
  };
  for (const c of captions as Cap[]) {
    const len = cur.map((x) => x.text).join(" ").length + c.text.length + 1;
    if (cur.length >= 3 || (cur.length >= 2 && len > 20) || (cur.length && len > 22)) flush();
    cur.push(c);
    if (/[.,!?]$/.test(c.text)) flush();
  }
  flush();
  return out.map((c, i) => ({ ...c, end: i + 1 < out.length ? Math.min(out[i + 1].start, c.end + 0.6) : c.end + 0.5 }));
})();

const SeamCaption: React.FC<{ t: number }> = ({ t }) => {
  const c = chunks.find((x) => t >= x.start - 0.04 && t < x.end);
  if (!c) return null;
  const p = pop(t, c.start - 0.04, 0.16);
  return (
    <div style={{ position: "absolute", left: 0, right: 0, top: PH, display: "flex", justifyContent: "center", zIndex: 50 }}>
      <div style={{ transform: `translateY(-50%) scale(${0.82 + 0.18 * p})`, opacity: k(t, c.start - 0.04, 0.08), background: "rgba(38,38,40,0.88)", borderRadius: 14, padding: "16px 22px 16px 30px", fontFamily: MONO, fontWeight: 700, fontSize: 46, letterSpacing: "0.14em", color: "#FFF", whiteSpace: "nowrap", boxShadow: "0 8px 22px rgba(0,0,0,0.22)" }}>
        {c.text}
      </div>
    </div>
  );
};

// ---------- master ----------
export const KontoauszugOpus: React.FC = () => {
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();
  const t = frame / fps;
  const scene = SCENES.find((s) => t >= s.from && t < s.to) ?? SCENES[SCENES.length - 1];
  const cam = camera(t, scene.from, Math.min(scene.to, 38.3));
  const dx = Math.sin(t * 0.6) * 6, dy = Math.cos(t * 0.45) * 5;
  // avatar framing (facefocus.py on tightened.mp4, panel 0.427): focus {0.518, 0.595}, scale 1.04 to centre the face, faceAt 0.56
  const s = 1.04, vw = W * s, vh = H * s, h = H - PH;
  const vLeft = Math.min(0, Math.max(W - vw, W / 2 - 0.518 * vw));
  const vTop = PH + Math.min(0, Math.max(h - vh, h * 0.56 - 0.595 * vh));
  const El = scene.El;
  return (
    <AbsoluteFill style={{ background: "#000" }}>
      <div style={{ position: "absolute", left: vLeft, top: vTop, width: vw, height: vh }}>
        <OffthreadVideo src={staticFile("render-fpn-kontoauszug-tightened.mp4")} style={{ width: "100%", height: "100%" }} />
      </div>
      <div style={{ position: "absolute", left: 0, top: 0, width: W, height: PH, overflow: "hidden", background: C.bg, boxShadow: "0 6px 18px rgba(0,0,0,0.18)" }}>
        <div style={{ position: "absolute", inset: -60, backgroundImage: `linear-gradient(${C.grid} 1.5px, transparent 1.5px), linear-gradient(90deg, ${C.grid} 1.5px, transparent 1.5px)`, backgroundSize: "28px 28px", transform: `translate(${dx * 0.4}px, ${dy * 0.4}px) scale(${1 + (cam - 1) * 0.4})` }} />
        <div style={{ position: "absolute", inset: 0, transform: `translate(${dx}px, ${dy}px) scale(${cam})`, transformOrigin: scene.origin }}>
          <El t={t} />
        </div>
      </div>
      <SeamCaption t={t} />
    </AbsoluteFill>
  );
};
