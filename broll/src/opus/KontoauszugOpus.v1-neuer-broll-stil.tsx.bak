import React from "react";
import { AbsoluteFill, Easing, interpolate, OffthreadVideo, staticFile, useCurrentFrame, useVideoConfig } from "remotion";
import { fonts } from "../theme";
import { SIMPLE_ICONS } from "../components/logoPaths";
import captions from "../../runs/fpn-kontoauszug/captions.json";

// @opusjake-style test (Henri 2026-10-12): re-cut of FP-N "Kontoauszug absetzen" (HeyGen 26546e04…) without a new
// HeyGen render. Split from frame 0: B-Roll panel on top (0-820 px), tightened avatar below, captions as a dark
// mono pill on the seam. Panel = off-white #F4F3EF with a 28 px grid, floating white cards (r 18, soft shadow),
// camera push-in ~3 % per sentence. Motifs are UI rebuilds (bank statement + scan line, chat window, receipt from a
// printer slot, checklist document), one stamp as payoff. FP pace: one event every ~0.6-0.8 s.
// Timeline = tightened timeline (captions.json); the 1.1x speed ramp + music are applied afterwards with the
// pipeline scripts (speed-ramp.mjs, prepare-music.mjs, mux-music.mjs).

const FPS = 25;
export const KA_FRAMES = Math.round(38.281 * FPS);
const W = 1080;
const H = 1920;
const PH = 820; // panel height = seam

const C = {
  bg: "#F4F3EF",
  grid: "rgba(0,0,0,0.045)",
  ink: "#151515",
  dim: "#8A877F",
  line: "#E7E4DD",
  card: "#FFFFFF",
  orange: "#FF6B35",
  orangeSoft: "#FFE3D6",
  green: "#1E9E57",
  greenSoft: "#E6F5EC",
  red: "#E5484D",
  gold: "#C9962E",
  chip: "#141414",
};
const MONO = "JetBrains Mono";
const shadow = "0 22px 48px rgba(20,20,20,0.10), 0 3px 8px rgba(20,20,20,0.06)";

const clamp = { extrapolateLeft: "clamp", extrapolateRight: "clamp" } as const;
const k = (t: number, a: number, d = 0.3, e = Easing.out(Easing.cubic)) => interpolate(t, [a, a + d], [0, 1], { ...clamp, easing: e });
const pop = (t: number, a: number, d = 0.38) => interpolate(t, [a, a + d], [0, 1], { ...clamp, easing: Easing.out(Easing.back(1.7)) });
const eur = (n: number, dec = 2) => n.toLocaleString("de-DE", { minimumFractionDigits: dec, maximumFractionDigits: dec }) + " €";
/** Pop-in style: fade + scale with a small overshoot, optional rise. */
const popStyle = (t: number, a: number, rise = 18, from = 0.7): React.CSSProperties => {
  const p = pop(t, a);
  return { opacity: k(t, a, 0.14), transform: `translateY(${(1 - Math.min(p, 1)) * rise}px) scale(${from + (1 - from) * p})` };
};

// ---------- sentence boundaries (camera push per sentence) and scenes ----------
const SENT = [0, 3.44, 6.32, 11.44, 13.92, 14.8, 18.88, 21.44, 25.88, 26.72, 29.63, 31.84, 36.48, 38.3];
type Scene = { from: number; to: number; origin: string; El: React.FC<{ t: number }> };

const camera = (t: number, from: number, to: number) => {
  const s = SENT.filter((x) => x >= from && x < to);
  const amt = Math.min(0.03, 0.075 / s.length);
  let sc = 1;
  s.forEach((a, i) => {
    const b = i + 1 < s.length ? s[i + 1] : to;
    sc += amt * interpolate(t, [a, b], [0, 1], { ...clamp, easing: Easing.inOut(Easing.sin) });
  });
  return sc;
};

// ---------- building blocks ----------
const Card: React.FC<{ style?: React.CSSProperties; children?: React.ReactNode }> = ({ style, children }) => (
  <div style={{ position: "absolute", background: C.card, borderRadius: 18, boxShadow: shadow, ...style }}>{children}</div>
);

const LabelChip: React.FC<{ text: string; dot?: string; style?: React.CSSProperties; size?: number }> = ({ text, dot = C.orange, style, size = 28 }) => (
  <div style={{ display: "inline-flex", alignItems: "center", gap: 12, background: C.chip, color: "#FFF", fontFamily: fonts.semibold, fontSize: size, padding: `${size * 0.36}px ${size * 0.8}px ${size * 0.36}px ${size * 0.6}px`, borderRadius: 999, boxShadow: "0 10px 24px rgba(0,0,0,0.18)", whiteSpace: "nowrap", ...style }}>
    <span style={{ width: size * 0.48, height: size * 0.48, borderRadius: "50%", background: dot }} />
    {text}
  </div>
);

const StepChip: React.FC<{ n: number; style?: React.CSSProperties; size?: number }> = ({ n, style, size = 28 }) => (
  <div style={{ display: "inline-block", background: C.orange, color: "#FFF", fontFamily: MONO, fontWeight: 800, fontSize: size, letterSpacing: "0.14em", padding: `${size * 0.32}px ${size * 0.62}px ${size * 0.32}px ${size * 0.76}px`, borderRadius: 10, boxShadow: "0 10px 22px rgba(255,107,53,0.30)", whiteSpace: "nowrap", ...style }}>
    SCHRITT {n}
  </div>
);

/** Framed mono metric with a counting number. */
const Metric: React.FC<{ t: number; at: number; label: string; value: number; dec?: number; color: string; valueColor?: string; size?: number; dur?: number }> = ({ t, at, label, value, dec = 2, color, valueColor = C.ink, size = 34, dur = 0.7 }) => {
  const v = value * k(t, at + 0.05, dur, Easing.out(Easing.quad));
  return (
    <div style={{ display: "inline-flex", alignItems: "center", gap: size * 0.6, background: "#FFF", border: `3px solid ${color}`, borderRadius: 14, padding: `${size * 0.42}px ${size * 0.7}px`, boxShadow: shadow, fontFamily: MONO, whiteSpace: "nowrap" }}>
      <span style={{ fontSize: size * 0.72, fontWeight: 800, letterSpacing: "0.14em", color }}>{label}</span>
      <span style={{ fontSize: size * 1.25, fontWeight: 800, color: valueColor, fontVariantNumeric: "tabular-nums" }}>{eur(v, dec)}</span>
    </div>
  );
};

const ClaudeMark: React.FC<{ size: number }> = ({ size }) => (
  <svg width={size} height={size} viewBox="0 0 24 24"><path d={SIMPLE_ICONS.claude.d} fill={SIMPLE_ICONS.claude.hex} /></svg>
);

const Check: React.FC<{ size: number; color?: string; p?: number }> = ({ size, color = "#FFF", p = 1 }) => (
  <svg width={size} height={size} viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke={color} strokeWidth={3.2} strokeLinecap="round" strokeLinejoin="round" strokeDasharray={24} strokeDashoffset={24 * (1 - p)} /></svg>
);

const Arrow: React.FC<{ t: number; at: number; w: number }> = ({ t, at, w }) => {
  const p = k(t, at, 0.35);
  return (
    <svg width={w} height={30} viewBox={`0 0 ${w} 30`} style={{ overflow: "visible" }}>
      <line x1={4} y1={15} x2={4 + (w - 18) * p} y2={15} stroke={C.ink} strokeWidth={3.5} strokeDasharray="8 7" strokeLinecap="round" />
      {p > 0.95 ? <path d={`M${w - 16} 6 L${w - 3} 15 L${w - 16} 24`} fill="none" stroke={C.ink} strokeWidth={3.5} strokeLinecap="round" strokeLinejoin="round" /> : null}
    </svg>
  );
};

// ---------- Scene A: bank statement + scan line (0 - 3.44) ----------
const ROWS = [
  { d: "03.01.", n: "REWE Markt", a: 54.21, ok: false },
  { d: "05.01.", n: "Adobe Creative Cloud", a: 59.49, ok: true },
  { d: "09.01.", n: "Miete Januar", a: 1150.0, ok: false },
  { d: "12.01.", n: "Restaurant Lido", a: 96.46, ok: true },
  { d: "15.01.", n: "Netflix", a: 13.99, ok: false },
  { d: "18.01.", n: "Amazon Ladekabel", a: 24.99, ok: true },
];
const SceneKonto: React.FC<{ t: number }> = ({ t }) => {
  const top = 282, rowH = 64, head = 78, cardW = 900, left = 90;
  const scanA = 0.75, scanB = 2.6;
  const scanY = head + interpolate(t, [scanA, scanB], [0, ROWS.length * rowH], { ...clamp, easing: Easing.inOut(Easing.sin) });
  const scanOn = t > scanA - 0.1 && t < scanB + 0.25;
  return (
    <>
      <div style={{ position: "absolute", left: 80, top: 126, fontFamily: fonts.bold, fontSize: 54, lineHeight: 1.08, color: C.ink, letterSpacing: -0.5, opacity: 1 - k(t, 2.6, 0.2), transform: `translateY(${(1 - k(t, 0, 0.3)) * 10 - k(t, 2.6, 0.2) * 30}px)` }}>
        Vergessene Ausgaben<br />= <span style={{ color: C.orange }}>zu viel Steuer</span>
      </div>
      <Card style={{ left, top, width: cardW, height: head + ROWS.length * rowH + 22, overflow: "hidden", transform: `translateY(${(1 - k(t, 0, 0.35)) * 24}px)` }}>
        <div style={{ height: head, display: "flex", alignItems: "center", justifyContent: "space-between", padding: "0 34px", borderBottom: `2px solid ${C.line}` }}>
          <span style={{ fontFamily: fonts.semibold, fontSize: 30, color: C.ink }}>Girokonto · Januar 2026</span>
          <span style={{ fontFamily: MONO, fontWeight: 700, fontSize: 20, letterSpacing: "0.14em", color: C.dim }}>KONTOAUSZUG</span>
        </div>
        {ROWS.map((r, i) => {
          const hit = scanA + ((i + 0.5) / ROWS.length) * (scanB - scanA);
          const g = r.ok ? k(t, hit, 0.2) : 0;
          return (
            <div key={i} style={{ position: "absolute", left: 0, right: 0, top: head + i * rowH, height: rowH, display: "flex", alignItems: "center", padding: "0 34px", gap: 22, background: `rgba(230,245,236,${g})`, borderBottom: i < ROWS.length - 1 ? `1.5px solid ${C.line}` : "none" }}>
              <span style={{ fontFamily: MONO, fontWeight: 500, fontSize: 22, color: C.dim, width: 92 }}>{r.d}</span>
              <span style={{ fontFamily: fonts.medium, fontSize: 30, color: g > 0.5 ? C.green : C.ink, flex: 1 }}>{r.n}</span>
              {r.ok ? <span style={{ fontFamily: MONO, fontWeight: 800, fontSize: 17, letterSpacing: "0.14em", color: "#FFF", background: C.green, padding: "6px 10px 6px 12px", borderRadius: 7, ...popStyle(t, hit + 0.05, 0, 0.5) }}>ABSETZBAR</span> : null}
              <span style={{ fontFamily: MONO, fontWeight: 700, fontSize: 27, color: g > 0.5 ? C.green : C.ink, width: 170, textAlign: "right" }}>−{r.a.toLocaleString("de-DE", { minimumFractionDigits: 2 })}</span>
            </div>
          );
        })}
        {scanOn ? (
          <div style={{ position: "absolute", left: 0, right: 0, top: scanY - 2, height: 4, background: C.orange, boxShadow: `0 0 18px 4px rgba(255,107,53,0.55)`, opacity: k(t, scanA - 0.1, 0.1) * (1 - k(t, scanB, 0.25)) }}>
            <div style={{ position: "absolute", left: 0, right: 0, bottom: 4, height: 70, background: "linear-gradient(to top, rgba(255,107,53,0.16), transparent)" }} />
          </div>
        ) : null}
      </Card>
      <div style={{ position: "absolute", right: 64, top: top - 30, ...popStyle(t, 0.35) }}><LabelChip text="Claude" /></div>
      <div style={{ position: "absolute", left: 80, top: 140, transformOrigin: "0% 50%", ...popStyle(t, 2.72, 10, 0.6) }}>
        <Metric t={t} at={2.72} label="ABSETZBAR" value={180.94} color={C.green} size={30} dur={0.6} />
      </div>
    </>
  );
};

// ---------- Scene B: Steuerberater bucht nur, was du ihm gibst (3.44 - 6.32) ----------
const Beleg: React.FC<{ title: string; amount: string; style?: React.CSSProperties; flag?: number }> = ({ title, amount, style, flag = 0 }) => (
  <div style={{ position: "absolute", width: 300, height: 150, background: "#FFF", borderRadius: 14, boxShadow: shadow, padding: "20px 24px", border: `3px solid rgba(229,72,77,${flag})`, ...style }}>
    <div style={{ fontFamily: MONO, fontWeight: 700, fontSize: 16, letterSpacing: "0.14em", color: C.dim }}>BELEG</div>
    <div style={{ fontFamily: fonts.semibold, fontSize: 27, color: C.ink, marginTop: 8 }}>{title}</div>
    <div style={{ fontFamily: MONO, fontWeight: 700, fontSize: 24, color: C.ink, marginTop: 10 }}>{amount}</div>
  </div>
);
const SceneBerater: React.FC<{ t: number }> = ({ t }) => {
  const fly = (at: number) => k(t, at, 0.5, Easing.inOut(Easing.cubic));
  const f1 = fly(4.38), f2 = fly(4.92);
  // from the pile (left) to the Buchhaltung card (right), with an arc
  const path = (p: number, y0: number) => ({ left: 80 + p * 560, top: y0 + (300 - y0) * p - Math.sin(p * Math.PI) * 110, transform: `rotate(${-4 + p * 4}deg) scale(${1 - p * 0.25})`, opacity: p > 0.9 ? 1 - (p - 0.9) * 10 : 1 });
  const booked = (at: number) => k(t, at + 0.48, 0.25);
  const flag = k(t, 5.78, 0.2);
  const shake = flag > 0 && t < 6.15 ? Math.sin(t * 70) * 4 * (1 - k(t, 5.78, 0.35)) : 0;
  return (
    <>
      <div style={{ position: "absolute", left: 80, top: 136, display: "flex", alignItems: "center", gap: 18 }}>
        <div style={popStyle(t, 3.5)}><LabelChip text="Du" /></div>
        <div style={{ opacity: k(t, 3.9, 0.1) }}><Arrow t={t} at={3.9} w={110} /></div>
        <div style={popStyle(t, 4.0)}><LabelChip text="Steuerberater" dot={C.green} /></div>
      </div>
      {/* Buchhaltung card (right) */}
      <Card style={{ left: 580, top: 250, width: 420, height: 430, padding: "28px 30px", ...popStyle(t, 3.44, 20, 0.92) }}>
        <div style={{ fontFamily: MONO, fontWeight: 700, fontSize: 18, letterSpacing: "0.14em", color: C.dim }}>BUCHHALTUNG 2026</div>
        <div style={{ fontFamily: fonts.bold, fontSize: 34, color: C.ink, marginTop: 6 }}>Gebucht</div>
        {[
          { n: "Büromiete", a: "1.150,00 €", at: 4.38 },
          { n: "Tanken", a: "74,30 €", at: 4.92 },
        ].map((r, i) => (
          <div key={i} style={{ display: "flex", alignItems: "center", gap: 14, marginTop: 20, opacity: booked(r.at), transform: `translateX(${(1 - booked(r.at)) * 20}px)` }}>
            <span style={{ width: 32, height: 32, borderRadius: 8, background: C.green, display: "flex", alignItems: "center", justifyContent: "center" }}><Check size={24} p={booked(r.at)} /></span>
            <span style={{ fontFamily: fonts.medium, fontSize: 27, color: C.ink, flex: 1 }}>{r.n}</span>
            <span style={{ fontFamily: MONO, fontWeight: 700, fontSize: 23, color: C.ink }}>{r.a}</span>
          </div>
        ))}
        <div style={{ position: "absolute", left: 30, right: 30, bottom: 28, borderTop: `2px dashed ${C.line}`, paddingTop: 16, fontFamily: MONO, fontWeight: 700, fontSize: 20, letterSpacing: "0.14em", color: C.dim, opacity: k(t, 5.4, 0.25) }}>
          NUR WAS ER BEKOMMT
        </div>
      </Card>
      {/* pile (left): the private one stays behind */}
      <Beleg title="Adobe-Abo" amount="59,49 €" flag={flag} style={{ left: 80 + shake, top: 330, transform: "rotate(-3deg)", ...{ opacity: k(t, 3.44, 0.2) } }} />
      {f2 < 0.99 ? <Beleg title="Tankbeleg" amount="74,30 €" style={{ ...path(f2, 315) }} /> : null}
      {f1 < 0.99 ? <Beleg title="Büromiete" amount="1.150,00 €" style={{ ...path(f1, 300) }} /> : null}
      <div style={{ position: "absolute", left: 90, top: 500, ...popStyle(t, 5.82, 12, 0.6) }}>
        <div style={{ fontFamily: MONO, fontWeight: 800, fontSize: 20, letterSpacing: "0.14em", color: "#FFF", background: C.red, padding: "8px 14px 8px 16px", borderRadius: 8 }}>PRIVAT BEZAHLT · FEHLT</div>
      </div>
    </>
  );
};

// ---------- Scene C: receipt from the printer slot (6.32 - 11.44) ----------
const BON = [
  { n: "SOFTWAREABO", a: 59.49, at: 8.27 },
  { n: "GESCHÄFTSESSEN", a: 96.46, at: 9.17 },
  { n: "LADEKABEL", a: 24.99, at: 10.32 },
];
const SceneBon: React.FC<{ t: number }> = ({ t }) => {
  const slotY = 150, bw = 600, bx = (W - bw) / 2;
  const headH = 150, itemH = 66, sumH = 112, pad = 36;
  const L = 52 + headH * k(t, 6.62, 0.6) + BON.reduce((s, b) => s + itemH * k(t, b.at - 0.05, 0.3), 0) + sumH * k(t, 10.82, 0.35) + pad * k(t, 6.62, 0.4);
  const sumV = 180.94 * k(t, 10.95, 0.55, Easing.out(Easing.quad));
  const zig = Array.from({ length: 31 }, (_, i) => `${100 - (i / 30) * 100}% ${i % 2 ? "100%" : "calc(100% - 14px)"}`).join(", ");
  const jitter = Math.sin(t * 60) * (t > 6.6 && t < 11.2 ? 0.8 : 0);
  return (
    <>
      {/* receipt (behind the printer front) */}
      <div style={{ position: "absolute", left: bx + jitter, top: slotY + 46, width: bw, height: L + 14, background: "#FFFEFB", boxShadow: "0 18px 36px rgba(20,20,20,0.12)", clipPath: `polygon(0 0, 100% 0, ${zig})`, overflow: "hidden" }}>
        <div style={{ position: "absolute", left: 0, right: 0, bottom: 14, padding: "0 40px", display: "flex", flexDirection: "column" }} />
        <div style={{ position: "absolute", left: 40, right: 40, top: 52, fontFamily: MONO, color: C.ink }}>
          <div style={{ height: headH, opacity: k(t, 6.75, 0.2) }}>
            <div style={{ fontWeight: 800, fontSize: 34, letterSpacing: "0.14em", textAlign: "center" }}>VERGESSENE AUSGABEN</div>
            <div style={{ fontWeight: 500, fontSize: 20, letterSpacing: "0.14em", textAlign: "center", color: C.dim, marginTop: 10, opacity: k(t, 7.15, 0.2) }}>PRIVAT BEZAHLT · 2026</div>
            <div style={{ borderTop: `3px dashed #CFCAC0`, marginTop: 26 }} />
          </div>
          {BON.map((b, i) => (
            <div key={i} style={{ height: itemH, display: "flex", alignItems: "center", justifyContent: "space-between", fontWeight: 700, fontSize: 29, opacity: k(t, b.at, 0.18), transform: `translateX(${(1 - k(t, b.at, 0.25)) * -16}px)` }}>
              <span style={{ letterSpacing: "0.06em" }}>{b.n}</span>
              <span>{b.a.toLocaleString("de-DE", { minimumFractionDigits: 2 })}</span>
            </div>
          ))}
          <div style={{ height: sumH, opacity: k(t, 10.85, 0.2) }}>
            <div style={{ borderTop: `3px dashed #CFCAC0`, marginTop: 14 }} />
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginTop: 20 }}>
              <span style={{ fontWeight: 800, fontSize: 30, letterSpacing: "0.14em" }}>SUMME</span>
              <span style={{ fontWeight: 800, fontSize: 42, color: C.gold, fontVariantNumeric: "tabular-nums" }}>{eur(sumV)}</span>
            </div>
          </div>
        </div>
      </div>
      {/* printer front with the slot */}
      <div style={{ position: "absolute", left: bx - 70, top: slotY, width: bw + 140, height: 74, borderRadius: 20, background: "#2A2A2E", boxShadow: "0 16px 30px rgba(0,0,0,0.22)", ...popStyle(t, 6.32, 10, 0.9) }}>
        <div style={{ position: "absolute", left: 60, right: 60, top: 44, height: 10, borderRadius: 5, background: "#0E0E10" }} />
        <div style={{ position: "absolute", left: 28, top: 22, width: 12, height: 12, borderRadius: "50%", background: t > 6.6 && t < 11.2 && Math.floor(t * 4) % 2 === 0 ? "#3DDC84" : "#2F5E43" }} />
        <div style={{ position: "absolute", right: 30, top: 16, fontFamily: MONO, fontWeight: 700, fontSize: 16, letterSpacing: "0.14em", color: "#8D8D93" }}>CLAUDE · PRINT</div>
      </div>
    </>
  );
};

// ---------- Scene D: zu viel gezahlt (11.44 - 14.8) ----------
const SceneSteuer: React.FC<{ t: number }> = ({ t }) => {
  const paid = 8421, need = 8042, bw = 640;
  const b1 = k(t, 11.6, 0.5, Easing.out(Easing.quad)), b2 = k(t, 12.15, 0.5, Easing.out(Easing.quad));
  const diff = k(t, 12.75, 0.3);
  const lift = k(t, 13.92, 0.35);
  return (
    <>
      <Card style={{ left: 120, top: 150 - lift * 20, width: 840, height: 330, padding: "30px 36px", ...popStyle(t, 11.44, 20, 0.92) }}>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline" }}>
          <span style={{ fontFamily: fonts.bold, fontSize: 36, color: C.ink }}>Einkommensteuer 2026</span>
          <span style={{ fontFamily: MONO, fontWeight: 700, fontSize: 18, letterSpacing: "0.14em", color: C.dim }}>BEISPIEL</span>
        </div>
        {[
          { l: "GEZAHLT", v: paid, p: b1, col: C.ink },
          { l: "NÖTIG", v: need, p: b2, col: "#B9B5AC" },
        ].map((r, i) => (
          <div key={i} style={{ marginTop: i ? 22 : 34 }}>
            <div style={{ display: "flex", justifyContent: "space-between", width: bw, fontFamily: MONO, fontWeight: 700, fontSize: 21, letterSpacing: "0.14em", color: C.dim }}>
              <span>{r.l}</span>
              <span style={{ color: C.ink, letterSpacing: 0, fontSize: 24, opacity: r.p }}>{Math.round(r.v * r.p).toLocaleString("de-DE")} €</span>
            </div>
            <div style={{ position: "relative", marginTop: 10, height: 34, width: bw, borderRadius: 9, background: "#EFEDE7" }}>
              <div style={{ position: "absolute", left: 0, top: 0, bottom: 0, width: bw * (r.v / paid) * r.p, borderRadius: 9, background: r.col }} />
              {i === 0 ? <div style={{ position: "absolute", left: bw * (need / paid), top: -6, bottom: -6, width: bw * (1 - need / paid), borderRadius: 6, background: C.red, opacity: diff, transform: `scaleX(${0.4 + 0.6 * diff})`, transformOrigin: "0 50%" }} /> : null}
            </div>
          </div>
        ))}
      </Card>
      <div style={{ position: "absolute", left: 0, right: 0, top: 512 - lift * 24, display: "flex", justifyContent: "center", ...popStyle(t, 12.84, 14, 0.6) }}>
        <Metric t={t} at={12.84} label="ZU VIEL GEZAHLT" value={379} dec={0} color={C.red} valueColor={C.red} size={36} dur={0.6} />
      </div>
      <div style={{ position: "absolute", left: 0, right: 0, top: 676, display: "flex", justifyContent: "center", gap: 22 }}>
        {[1, 2, 3].map((n, i) => <div key={n} style={popStyle(t, 13.95 + i * 0.22, 16, 0.5)}><StepChip n={n} size={26} /></div>)}
      </div>
    </>
  );
};

// ---------- Scene E: chat window, steps 1 + 2 + Claude's answer (14.8 - 25.88) ----------
const TYPED = "Ich bin selbstständiger Grafikdesigner. Markiere alles, was eine Betriebsausgabe sein könnte.";
const MARKED = [
  { n: "Adobe Creative Cloud", a: "59,49 €", why: "Software für deine Aufträge", at: 22.06 },
  { n: "Restaurant Lido", a: "96,46 €", why: "Geschäftsessen mit Kunde", at: 22.79 },
  { n: "Amazon Ladekabel", a: "24,99 €", why: "Arbeitsmittel", at: 23.65 },
];
const SceneChat: React.FC<{ t: number }> = ({ t }) => {
  const wx = 70, wy = 192, ww = 940, wh = 598, bar = 56, input = 78;
  const vp = wh - bar - input - 20;
  const gap = 18;
  const h1 = 176 * k(t, 15.45, 0.3), h2 = 168 * k(t, 19.45, 0.3);
  const h3 = (64 + MARKED.reduce((s, m) => s + 112 * k(t, m.at - 0.05, 0.3), 0)) * k(t, 21.44, 0.3);
  const total = h1 + (h2 ? gap + h2 : 0) + (h3 ? gap + h3 : 0);
  const off = Math.max(0, total - vp);
  const prog = interpolate(t, [15.9, 17.3], [0, 1], { ...clamp, easing: Easing.inOut(Easing.quad) });
  const done = k(t, 17.3, 0.2);
  const nChars = Math.round(interpolate(t, [19.66, 21.25], [0, TYPED.length], clamp));
  const caret = t < 21.4 && Math.floor(t * 3) % 2 === 0;
  const step2 = t >= 18.88;
  const dots = t > 21.5 && t < 22.06;
  return (
    <>
      <div style={{ position: "absolute", left: wx, top: 118 }}>
        <div key={step2 ? 2 : 1} style={popStyle(t, step2 ? 18.88 : 14.8, 10, 0.6)}><StepChip n={step2 ? 2 : 1} /></div>
      </div>
      <div style={{ position: "absolute", right: wx, top: 118, ...popStyle(t, 18.0, 10, 0.6), opacity: k(t, 18.0, 0.14) * (1 - k(t, 24.2, 0.15)) }}>
        <div style={{ fontFamily: MONO, fontWeight: 800, fontSize: 22, letterSpacing: "0.14em", color: C.ink, background: "#FFF", border: `2.5px solid ${C.ink}`, borderRadius: 10, padding: "10px 14px 10px 18px" }}>JAN – DEZ · 12 MONATE</div>
      </div>
      <Card style={{ left: wx, top: wy, width: ww, height: wh, overflow: "hidden", ...popStyle(t, 14.95, 24, 0.94) }}>
        <div style={{ height: bar, background: "#F6F5F1", borderBottom: `1.5px solid ${C.line}`, display: "flex", alignItems: "center", padding: "0 22px", gap: 10, position: "relative" }}>
          {["#FF5F57", "#FEBC2E", "#28C840"].map((c) => <span key={c} style={{ width: 16, height: 16, borderRadius: "50%", background: c }} />)}
          <div style={{ position: "absolute", left: 0, right: 0, textAlign: "center", fontFamily: fonts.semibold, fontSize: 22, color: "#6E6B65", display: "flex", justifyContent: "center", alignItems: "center", gap: 8 }}><ClaudeMark size={20} />Claude</div>
        </div>
        <div style={{ position: "absolute", left: 26, right: 26, top: bar + 14, height: vp, overflow: "hidden" }}>
          <div style={{ position: "absolute", left: 0, right: 0, top: -off, display: "flex", flexDirection: "column", gap }}>
            {/* M1: file upload */}
            <div style={{ height: h1, overflow: "hidden", display: "flex", justifyContent: "flex-end" }}>
              <div style={{ width: 600, height: 176, boxSizing: "border-box", background: "#F1EFEA", borderRadius: 18, padding: "22px 24px", display: "flex", gap: 20, opacity: k(t, 15.45, 0.2) }}>
                <div style={{ width: 64, height: 80, borderRadius: 8, background: C.green, color: "#FFF", fontFamily: MONO, fontWeight: 800, fontSize: 17, display: "flex", alignItems: "flex-end", justifyContent: "center", paddingBottom: 10, boxSizing: "border-box" }}>CSV</div>
                <div style={{ flex: 1 }}>
                  <div style={{ fontFamily: fonts.semibold, fontSize: 28, color: C.ink }}>kontoauszug_2026.csv</div>
                  <div style={{ fontFamily: MONO, fontWeight: 500, fontSize: 19, color: C.dim, marginTop: 4 }}>2,4 MB · 1.284 Buchungen</div>
                  <div style={{ position: "relative", height: 12, borderRadius: 6, background: "#E2DFD8", marginTop: 18, overflow: "hidden" }}>
                    <div style={{ position: "absolute", left: 0, top: 0, bottom: 0, width: `${prog * 100}%`, background: done > 0.5 ? C.green : C.orange, borderRadius: 6 }} />
                  </div>
                  <div style={{ fontFamily: MONO, fontWeight: 700, fontSize: 17, letterSpacing: "0.14em", color: done > 0.5 ? C.green : C.dim, marginTop: 10 }}>{done > 0.5 ? "HOCHGELADEN ✓" : `LÄDT … ${Math.round(prog * 100)} %`}</div>
                </div>
              </div>
            </div>
            {/* M2: typed message */}
            {h2 ? (
              <div style={{ height: h2, overflow: "hidden", display: "flex", justifyContent: "flex-end" }}>
                <div style={{ width: 720, height: 168, boxSizing: "border-box", background: "#F1EFEA", borderRadius: 18, padding: "20px 26px", fontFamily: fonts.medium, fontSize: 29, lineHeight: 1.36, color: C.ink }}>
                  {TYPED.slice(0, nChars)}
                  <span style={{ display: "inline-block", width: 3, height: 32, background: C.orange, verticalAlign: "-5px", marginLeft: 2, opacity: caret ? 1 : 0 }} />
                </div>
              </div>
            ) : null}
            {/* M3: Claude marks the bookings */}
            {h3 ? (
              <div style={{ height: h3, overflow: "hidden" }}>
                <div style={{ display: "flex", alignItems: "center", gap: 12, height: 52 }}>
                  <ClaudeMark size={34} />
                  <span style={{ fontFamily: fonts.semibold, fontSize: 26, color: C.ink }}>3 Buchungen markiert</span>
                  {dots ? <span style={{ fontFamily: MONO, fontWeight: 800, fontSize: 30, color: C.dim, marginLeft: 6 }}>{".".repeat(1 + (Math.floor(t * 8) % 3))}</span> : null}
                </div>
                {MARKED.map((m, i) => {
                  const a = k(t, m.at, 0.25);
                  const hl = k(t, 25.2 + i * 0.12, 0.35);
                  return (
                    <div key={i} style={{ marginTop: 12, height: 100, boxSizing: "border-box", background: C.greenSoft, borderLeft: `7px solid ${C.green}`, borderRadius: 12, padding: "14px 22px", opacity: a, transform: `translateY(${(1 - a) * 18}px)` }}>
                      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                        <span style={{ fontFamily: fonts.semibold, fontSize: 28, color: C.ink }}>{m.n}</span>
                        <span style={{ fontFamily: MONO, fontWeight: 700, fontSize: 26, color: C.green }}>{m.a}</span>
                      </div>
                      <div style={{ fontFamily: fonts.regular, fontSize: 23, color: "#5F5C55", marginTop: 6 }}>
                        <span style={{ backgroundImage: `linear-gradient(${C.orangeSoft}, ${C.orangeSoft})`, backgroundRepeat: "no-repeat", backgroundSize: `${hl * 100}% 100%`, padding: "0 4px" }}>→ {m.why}</span>
                      </div>
                    </div>
                  );
                })}
              </div>
            ) : null}
          </div>
        </div>
        <div style={{ position: "absolute", left: 22, right: 22, bottom: 16, height: input - 16, borderRadius: 16, border: `2px solid ${C.line}`, display: "flex", alignItems: "center", justifyContent: "space-between", padding: "0 10px 0 22px" }}>
          <span style={{ fontFamily: fonts.regular, fontSize: 23, color: "#AAA69E" }}>Antworte Claude …</span>
          <span style={{ width: 44, height: 44, borderRadius: 12, background: C.orange, display: "flex", alignItems: "center", justifyContent: "center", color: "#FFF", fontFamily: fonts.bold, fontSize: 26 }}>↑</span>
        </div>
      </Card>
      <div style={{ position: "absolute", right: wx, top: 104, transformOrigin: "100% 50%", ...popStyle(t, 24.4, 10, 0.6) }}>
        <Metric t={t} at={24.4} label="ABSETZBAR" value={180.94} color={C.green} size={24} dur={0.6} />
      </div>
    </>
  );
};

