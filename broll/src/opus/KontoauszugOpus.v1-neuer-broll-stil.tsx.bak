          {LIST.map((r, i) => {
            const a = k(t, r.at, 0.25);
            const tk = k(t, r.tick, 0.22);
            return (
              <div key={i} style={{ display: "flex", alignItems: "center", gap: 22, height: 92, borderBottom: `1.5px solid ${C.line}`, opacity: a, transform: `translateX(${(1 - a) * 24}px)` }}>
                <span style={{ width: 38, height: 38, borderRadius: 9, border: `3px solid ${tk > 0.1 ? C.orange : "#CFCAC0"}`, background: `rgba(255,107,53,${tk})`, display: "flex", alignItems: "center", justifyContent: "center", boxSizing: "border-box" }}><Check size={28} p={tk} /></span>
                <div style={{ flex: 1 }}>
                  <div style={{ fontFamily: fonts.semibold, fontSize: 29, color: C.ink }}>{r.n}</div>
                  <div style={{ fontFamily: MONO, fontWeight: 700, fontSize: 17, letterSpacing: "0.14em", color: C.dim, marginTop: 2 }}>{r.c}</div>
                </div>
                <span style={{ fontFamily: MONO, fontWeight: 700, fontSize: 27, color: C.ink }}>{r.a}</span>
              </div>
            );
          })}
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginTop: 22, opacity: k(t, 28.84, 0.25) }}>
            <span style={{ fontFamily: MONO, fontWeight: 800, fontSize: 24, letterSpacing: "0.14em", color: C.ink }}>SUMME</span>
            <span style={{ fontFamily: MONO, fontWeight: 800, fontSize: 36, color: C.gold }}>{eur(180.94 * k(t, 28.84, 0.5, Easing.out(Easing.quad)))}</span>
          </div>
        </Card>
        {st > 0 ? (
          <div style={{ position: "absolute", left: 560, top: 520, transform: `translate(-50%, -50%) rotate(-9deg) scale(${sp})`, opacity: k(t, STAMP_AT, 0.08) }}>
            <div style={{ fontFamily: MONO, fontWeight: 800, fontSize: 60, letterSpacing: "0.12em", color: C.orange, border: `7px solid ${C.orange}`, borderRadius: 16, padding: "14px 30px 14px 36px", background: "rgba(255,255,255,0.86)", whiteSpace: "nowrap", boxShadow: "0 12px 30px rgba(255,107,53,0.18)" }}>✓ VORBEREITET</div>
          </div>
        ) : null}
      </div>
    </>
  );
};

